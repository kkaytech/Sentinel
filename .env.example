# Copy to .env and replace every value. Placeholders only; never commit real secrets.
POSTGRES_PASSWORD=change-me-bootstrap-superuser
SENTINEL_OWNER_PASSWORD=change-me-owner
SENTINEL_APP_PASSWORD=change-me-app
SENTINEL_READER_PASSWORD=change-me-reader

# At least 32 characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SENTINEL_SESSION_SECRET=change-me-to-a-long-random-value-of-32-plus-chars

# development | demo | test | production
SENTINEL_ENV=development
SENTINEL_HTTPS=false

# Capacity limits (NFR-001). Defaults shown.
SENTINEL_MAX_FILE_MB=20
SENTINEL_MAX_ROWS=200000
# Contract and rule files. Defaults to <repo>/config; the image sets /srv/sentinel/config.
# SENTINEL_CONFIG_DIR=

# AI stays disabled until the product owner approves live provider use (CLAUDE.md).
SENTINEL_AI_ENABLED=false
